{
  "name": "sycamore-row",
  "productName": "Sycamore Row",
  "version": "1.0.0",
  "description": "Sycamore Row — a gothic mystery in five levels.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "node tools/serve.js . 5173",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.sycamorerow.game",
    "productName": "Sycamore Row",
    "files": [
      "index.html",
      "src/**/*",
      "styles/**/*",
      "assets/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Sycamore Row"
    }
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/unifrakturcook": "^5.3.0",
    "electron": "^45.4.1"
  }
}
